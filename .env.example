# ── Windmill Exchange — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
#
# ── Public (exposed to browser) ───────────────────────────────────────────────

# Base URL of the deployed site (used for OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=

# Default chain ID for the Web3 wallet context
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# RPC URL for local development node
NEXT_PUBLIC_RPC_URL=

# Deployed WindmillExchange contract addresses per chain
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCAL=
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_WINDMILL_EXCHANGE_ADDRESS=
NEXT_PUBLIC_CONTRACT_ADDRESS_ETH=
NEXT_PUBLIC_CONTRACT_ADDRESS_POLYGON=
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE=
NEXT_PUBLIC_CONTRACT_ADDRESS_BSC=
NEXT_PUBLIC_CONTRACT_ADDRESS_ETC=
