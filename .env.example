# ── Windmill Exchange — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
#
# ── Public (exposed to browser) ───────────────────────────────────────────────

# Base URL of the deployed site (used for OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=

# Default chain ID for the Web3 wallet context
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# RPC URL for local development node
NEXT_PUBLIC_RPC_URL=

# Deployed WindmillExchange contract addresses per chain
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCAL=
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_WINDMILL_EXCHANGE_ADDRESS=
NEXT_PUBLIC_CONTRACT_ADDRESS_ETH=
NEXT_PUBLIC_CONTRACT_ADDRESS_POLYGON=
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE=
NEXT_PUBLIC_CONTRACT_ADDRESS_BSC=
NEXT_PUBLIC_CONTRACT_ADDRESS_ETC=

# ── Server-side only (NEVER prefix with NEXT_PUBLIC_) ─────────────────────────

# Resend — transactional email delivery (https://resend.com)
# Create a free account, verify your sending domain, and generate an API key.
RESEND_API_KEY=

# The verified sender address configured in Resend (e.g. support@yourdomain.com)
SUPPORT_FROM_EMAIL=

# The destination inbox that receives support tickets (e.g. team@aossie.org)
SUPPORT_TO_EMAIL=

# Upstash Redis — serverless rate limiting (https://upstash.com)
# Create a free Redis database and copy the REST URL and token from the dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
